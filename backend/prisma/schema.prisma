
// Prisma schema for SignSync Lite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DEAF_USER
  HEARING_USER
  ADMIN
}

enum ContactStatus {
  NEW
  READ
  RESPONDED
}

model User {
  id                    String   @id @default(uuid())
  username              String   @unique
  email                 String   @unique
  passwordHash          String
  role                  UserRole @default(DEAF_USER)
  createdAt             DateTime @default(now())
  calibrationProfile    CalibrationProfile?
  translationSessions   TranslationSession[]
}

model CalibrationProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  armLengthRatio   Float
  handScaleFactor  Float
  signingSpeedFps  Float
  calibratedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContextPreset {
  id                          String   @id @default(uuid())
  name                        String   @unique
  vocabularyDomainDescription  String

  translationSessions TranslationSession[]
}

model TranslationSession {
  id                String   @id @default(uuid())
  userId            String
  presetId          String
  startTime         DateTime @default(now())
  endTime           DateTime?
  totalSignsDetected Int      @default(0)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset  ContextPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  records TranslationRecord[]
}

model TranslationRecord {
  id                  String   @id @default(uuid())
  sessionId           String
  rawGlossSequence    String
  synthesizedSentence String
  confidenceScore     Float
  timestamp           DateTime @default(now())

  session TranslationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime      @default(now())
  status    ContactStatus @default(NEW)
}

model LegalDocument {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  sections      Json
  effectiveDate DateTime
  lastUpdated   DateTime
}
